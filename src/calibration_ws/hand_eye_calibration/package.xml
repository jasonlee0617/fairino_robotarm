<?xml version="1.0"?>
<package format="3">
  <name>hand_eye_calibration</name>
  <version>0.1.0</version>
  <description>
    Fairino eye-in-hand calibration with a fixed 20-slot joint-waypoint sequence.
  </description>
  <license>MIT</license>

  <author>Yifei Cheng</author>
  <maintainer email="ycheng517@gmail.com">Yifei Cheng</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ros2_aruco_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>easy_handeye2</exec_depend>
  <exec_depend>easy_handeye2_msgs</exec_depend>
  <exec_depend>fairino_arm_moveit_config</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>myrobot_common</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  <exec_depend>ros2_aruco</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>easy_handeye2</test_depend>
  <test_depend>easy_handeye2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
