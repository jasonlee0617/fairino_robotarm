<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>visual_grasping_bringup</name>
  <version>0.0.0</version>
  <description>YOLOv8 grasping package: elongated-object-box grasping, dynamic collision objects, task planning.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>depthai_ros_driver</depend>
  <exec_depend>realsense2_camera</exec_depend>

  <exec_depend>visual_perception</exec_depend>
  <exec_depend>myrobot_common</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>pymoveit2</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>hand_eye_calibration</exec_depend>
  <exec_depend>fairino_arm_moveit_config</exec_depend>
  <exec_depend>trajectory_retime_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
