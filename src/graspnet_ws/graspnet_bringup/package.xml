<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>graspnet_bringup</name>
  <version>0.0.0</version>
  <description>ROS 2 bringup and execution nodes for GraspNet grasping.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>LicenseRef-GraspNet-NonCommercial</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pymoveit2</depend>
  <depend>myrobot_common</depend>
  <depend>graspnet_source</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>fairino_arm_moveit_config</exec_depend>
  <exec_depend>hand_eye_calibration</exec_depend>
  <exec_depend>trajectory_retime_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
